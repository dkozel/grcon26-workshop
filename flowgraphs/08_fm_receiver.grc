options:
  parameters:
    alias: ''
    author: GNU Radio Intro Workshop
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: File Source -> channel select + decimate -> squelch -> NBFM demod
      -> soundcard
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: fm_receiver
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: NBFM Receiver (from a recording)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    state: enabled

blocks:
- name: audio_rate
