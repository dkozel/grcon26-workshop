  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: dc_offset_blk
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: add a DC offset to every sample.\n\
      \nGNU Radio calls work() over and over with a chunk of input samples and a\n\
      buffer to fill with output samples.  A sync_block produces exactly one\noutput\
      \ sample for every input sample.\n\"\"\"\n\nimport numpy as np\nfrom gnuradio\
      \ import gr\n\n\nclass blk(gr.sync_block):  # other base classes are basic_block,\
      \ decim_block, interp_block\n    \"\"\"DC Offset - adds a constant value to\
      \ every sample\"\"\"\n\n    def __init__(self, dc_offset=0.5):  # only default\
      \ arguments here\n        \"\"\"arguments to this function show up as parameters\
      \ in GRC\"\"\"\n        gr.sync_block.__init__(\n            self,\n       \
      \     name='DC Offset',   # will show up in GRC\n            in_sig=[np.float32],\n\
      \            out_sig=[np.float32]\n        )\n        # if an attribute with\
      \ the same name as a parameter is found,\n        # a callback is registered\
      \ (properties work, too).\n        self.dc_offset = dc_offset\n\n    def work(self,\
      \ input_items, output_items):\n        \"\"\"add dc_offset to every input sample\"\
      \"\"\n        output_items[0][:] = input_items[0] + self.dc_offset\n       \
      \ return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    dc_offset: offset
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('DC Offset', 'blk', [('dc_offset', '0.5')], [('0', 'float', 1)], [('0',
      'float', 1)], 'DC Offset - adds a constant value to every sample', ['dc_offset'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 280]
    rotation: 0
    state: enabled
