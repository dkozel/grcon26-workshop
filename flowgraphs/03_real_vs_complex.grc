    alias: ''
    author: GNU Radio Intro Workshop
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: A complex tone, and its real part on its own
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
